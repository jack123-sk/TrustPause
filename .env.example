# TrustPause - Optional Configuration
# By default, TrustPause runs 100% locally in the browser with ZERO external network calls.
# Any external threat intelligence lookups are strictly opt-in and disabled by default.

# Optional: External Reputation Lookup Service (default: disabled)
# VITE_ENABLE_EXTERNAL_THREAT_INTEL=false

# Optional: Public Domain Reputation API Key (e.g., Google Safe Browsing / VirusTotal)
# VITE_THREAT_INTEL_API_KEY=
